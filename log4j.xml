<?xml version="1.0" encoding="UTF-8"?>
<Configuration xmlns="https://apache.org"
               xmlns:xsi="http://w3.org"
               xsi:schemaLocation="https://apache.org https://apache.org/log4j-config-2.xsd">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
